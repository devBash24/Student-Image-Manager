{
  "language": "en",
  "student_number_patterns": [
    "^202\\d{7}$",
    "\\d{10}",
    "[A-Z]{2}\\d{6}"
  ],
  "department_rules": {
    "20": "IT",
    "30": "Business",
    "51": "Atmospheric Science"
  },
  "excel_columns": {
    "student_no": "student_no",
    "first_name": "first_name",
    "last_name": "last_name",
    "passport_number": "passport_number"
  },
  "ocr": {
    "tesseract_cmd": "",
    "crop_bottom_ratio": 0.28,
    "threshold": 150,
    "tesseract_config": "--psm 6",
    "language": "eng",
    "confidence_threshold": 60
  },
  "output": {
    "mode": "copy",
    "folder_name": "output",
    "folder_path": "",
    "unknown_department": "Unknown"
  },
  "supported_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".tif",
    ".tiff",
    ".bmp"
  ]
